---
import type { MenuCategory } from '../../../types/berraco.types';
import MenuItemRow from './MenuItemRow.astro';

interface Props {
  category: MenuCategory;
}

const { category } = Astro.props;

// A category with at least one photo shows the thumbnail column (placeholder
// for the photo-less items). A category with NO photos renders as a clean
// text-only list — no thumbnails at all (spirits, beers, sodas, sides).
const hasPhotos = category.items.some((i) => i.image);
---

<section
  id={category.id}
  class="carta-category scroll-mt-40"
  style="content-visibility: auto; contain-intrinsic-size: auto 480px;"
  aria-labelledby={`${category.id}-title`}
>
  <h3 id={`${category.id}-title`} class="eyebrow mb-3 text-orange-400">{category.name}</h3>
  <ul class="rounded-[var(--radius-lg)] border border-[var(--color-line)] bg-surface px-4">
    {category.items.map((item) => <MenuItemRow item={item} kitchen={category.kitchen} showThumb={hasPhotos} />)}
  </ul>
</section>
